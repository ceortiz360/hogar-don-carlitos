            cta: 'Coordinar entrega por WhatsApp'
          },
          sponsor: {
            title: 'Apadrina un peludito',
            body: 'Con un aporte mensual sostienes el cuidado de un perrito hasta que encuentre su hogar.',
            waMsg: (amt) => '¡Hola! Quiero apadrinar a un peludito con un aporte mensual de ' + amt + '. ¿Cómo lo hago?'
          }
        },
        contact: {
          kicker: 'Contáctanos',
          title: 'Estamos a un mensaje de distancia',
          lead: 'Escríbenos para adoptar, donar, ser voluntario o resolver cualquier duda. Nos encanta saber de personas que quieren ayudar.',
          locLabel: 'Ubicación',
          locValue: 'Colombia · A convenir',
          formTitle: 'Escríbenos',
          formSub: 'Cuéntanos cómo quieres ayudar y te responderemos por WhatsApp.',
          fName: 'Tu nombre',
          phName: '¿Cómo te llamas?',
          fMsg: 'Mensaje',
          phMsg: 'Quiero adoptar / donar / ser voluntario…',
          send: 'Enviar por WhatsApp',
          waMsg: (n, m) => '¡Hola Hogar Don Carlitos! Soy ' + (n || 'un amigo de los animalitos') + '. ' + (m || 'Quiero ayudar.')
        },
        poster: {
          title: 'Hoy puedes ser el héroe de un peludito',
          sub: 'No necesitas mucho para cambiar una vida. Una donación, una adopción o simplemente compartir nuestra página ya es un acto de amor.',
          ctaDonate: 'Donar por WhatsApp',
          ctaContact: 'Escríbenos'
        },
        footer: {
          tagline: 'Rescatamos, cuidamos y buscamos hogar para perritos abandonados. Gracias por ser parte de su historia.',
          navTitle: 'Navegación',
          followTitle: 'Síguenos',
          rights: 'Hecho con amor por los animalitos.'
        }
      },
      en: {
        brandTag: 'Animal foundation',
        switchTo: 'Ver en español (Spanish)',
        langOther: 'ES',
        nav: { home: 'Home', about: 'About us', adopt: 'Adoptions', contact: 'Contact', donate: 'Donate' },
        hero: {
          kicker: 'Help me find a home',
          title: 'Hi… could you be my family?',
          sub: "I'm one of the little ones waiting at Hogar Don Carlitos. With your help I get food, a warm place to sleep, and the chance to find a forever home.",
          ctaDonate: 'I want to help',
          ctaAdopt: 'Meet me',
          welcomeBubble: 'Hi, welcome to the Hogar Don Carlitos page',
          captions: [
            'They rescued me from the street on a rainy day'
          ]
        },
        impact: {
          kicker: 'What we achieve together',
          title: 'Every rescue starts with someone who chose not to look away',
          stats: [
            { n: '15', l: 'Years opening the door to those nobody wanted' },
            { n: '31', l: 'Little ones waiting today for a family' },
            { n: '8', l: 'Dogs this whole story began with' }
          ]
        },
        aboutTeaser: {
          kicker: 'Who cares for us',
          title: 'Fifteen years making a home',
          body: 'This began in a house, with eight dogs and a strong wish to help. Fifteen years later we still rescue the most vulnerable ones: we heal them, spay and neuter them, vaccinate them, and stay with them until their family arrives. All of it is possible thanks to kind-hearted people like you.',
          cta: 'Read our story'
        },
        featured: {
          kicker: 'Looking for a home',
          title: "They're ready to love you already",
          cta: 'See all'
        },
        about: {
          kicker: 'About us',
          title: 'We are the voice of those who cannot ask for help',
          lead: 'The shelter was born 15 years ago. It all started at home, caring for five hunting dogs and the three that were already mine. I never imagined how far that first gesture would take us.',
          storyTitle: 'How it all began',
          story1: 'Over time we set out to rescue the most vulnerable ones: we healed them, spayed and neutered them, vaccinated them, and gave them a safe place to start over. Every rescue taught us something new about what a dog can endure and forgive.',
          story2: 'Today this is a place full of love. Every little one arrives carrying a story, and those experiences gave each of them their own unmistakable personality. Once you know them, giving up on them is simply not possible — that is why we are still here, one more day, for every single one.',
          story3: 'Right now there are 31 members at the shelter waiting for a family to love them.',
          valuesTitle: 'What drives us',
          values: [
            { t: 'Unconditional love', d: 'Every dog receives affection, patience and the time it needs to heal.' },
            { t: 'Full transparency', d: 'Every donation goes to the direct care of the animals. No middlemen.' },
            { t: 'Responsible adoption', d: 'We look for homes that understand adopting is a lifelong commitment.' }
          ]
        },
        adopt: {
          kicker: 'Adoptions',
          title: "They're already waiting for you",
          lead: 'These are some of our little ones looking for a home. All are dewormed and in the process of vaccination and neutering. If one steals your heart, message us on WhatsApp and we will tell you how to adopt.',
          request: 'Request adoption',
          note: 'Adoption is free, but involves an interview and a responsible commitment. Not ready to adopt yet? You can also sponsor a dog or help us as a foster home.',
          waMsg: (name) => 'Hi Hogar Don Carlitos! I would like to adopt ' + name + '. Could you tell me about the process?'
        },
        donate: {
          kicker: 'Donations',
          title: 'With just a little, you change their lives',
          lead: 'Your help becomes food, medicine and a safe place to sleep. Choose the way to support that suits you best: every contribution counts and goes straight to the little ones.',
          bank: {
            title: 'Bank transfer',
            body: 'Make your donation directly to our account. (Replace these details with the foundation\u2019s.)',
            rows: [
              { k: 'Bank', v: 'Bancolombia' },
              { k: 'Account type', v: 'Savings' },
              { k: 'Number', v: '000-000000-00' },
              { k: 'Holder', v: 'Fundación Hogar Don Carlitos' }
            ]
          },
          kind: {
            title: 'In-kind donation',
            body: 'We also need supplies for the shelter\u2019s daily life:',
            items: ['Dog food', 'Medicine and dewormers', 'Blankets and beds', 'Leashes, bowls and toys'],
            cta: 'Arrange drop-off via WhatsApp'
          },
          sponsor: {
            title: 'Sponsor a dog',
            body: 'With a monthly contribution you sustain the care of a dog until it finds its home.',
            waMsg: (amt) => 'Hi! I want to sponsor a dog with a monthly contribution of ' + amt + '. How do I do it?'
          }
        },
        contact: {
          kicker: 'Contact',
          title: "We're just one message away",
          lead: 'Write to us to adopt, donate, volunteer or ask anything. We love hearing from people who want to help.',
          locLabel: 'Location',
          locValue: 'Colombia · By arrangement',
          formTitle: 'Write to us',
          formSub: 'Tell us how you want to help and we will reply on WhatsApp.',
          fName: 'Your name',
          phName: 'What is your name?',
          fMsg: 'Message',
          phMsg: 'I want to adopt / donate / volunteer…',
          send: 'Send via WhatsApp',
          waMsg: (n, m) => 'Hi Hogar Don Carlitos! I\u2019m ' + (n || 'a friend of the animals') + '. ' + (m || 'I want to help.')
        },
        poster: {
          title: 'Today you can be a little dog\u2019s hero',
          sub: 'You don\u2019t need much to change a life. A donation, an adoption, or simply sharing our page is already an act of love.',
          ctaDonate: 'Donate via WhatsApp',
          ctaContact: 'Write to us'
        },
        footer: {
          tagline: 'We rescue, care for and find homes for abandoned dogs. Thank you for being part of their story.',
          navTitle: 'Navigation',
          followTitle: 'Follow us',
          rights: 'Made with love for the animals.'
        }
      }
    };
  }

  dogsData() {
    return [
      { id: 'luna',  es: { n: 'Luna',  meta: '2 años · Mediana',   p: 'Cariñosa y un poco tímida al principio; cuando confía, no se despega de ti.', h: 'Vacunada y esterilizada' }, en: { n: 'Luna',  meta: '2 yrs · Medium', p: 'Loving and a bit shy at first; once she trusts you, she never leaves your side.', h: 'Vaccinated & spayed' } },
      { id: 'max',   es: { n: 'Max',   meta: '4 años · Grande',    p: 'Juguetón y leal, perfecto para una familia activa que ame los paseos.', h: 'Vacunado y esterilizado' }, en: { n: 'Max',   meta: '4 yrs · Large', p: 'Playful and loyal, perfect for an active family that loves walks.', h: 'Vaccinated & neutered' } },
      { id: 'canela',es: { n: 'Canela',meta: '1 año · Pequeña',    p: 'Pura energía y dulzura; le encanta jugar y recibir mimos.', h: 'Vacunada' }, en: { n: 'Canela', meta: '1 yr · Small', p: 'Pure energy and sweetness; loves to play and get cuddles.', h: 'Vaccinated' } },
      { id: 'rocky', es: { n: 'Rocky', meta: '5 años · Grande',    p: 'Tranquilo y protector; el compañero fiel que siempre está a tu lado.', h: 'Vacunado y esterilizado' }, en: { n: 'Rocky', meta: '5 yrs · Large', p: 'Calm and protective; the faithful companion always by your side.', h: 'Vaccinated & neutered' } },
      { id: 'nina',  es: { n: 'Nina',  meta: '3 años · Mediana',   p: 'Sociable y paciente, se lleva de maravilla con los niños.', h: 'Vacunada y esterilizada' }, en: { n: 'Nina',  meta: '3 yrs · Medium', p: 'Sociable and patient, gets along wonderfully with kids.', h: 'Vaccinated & spayed' } },
      { id: 'simon', es: { n: 'Simón', meta: '8 meses · Pequeño',  p: 'Curioso y travieso; un cachorro con muchas ganas de aprender.', h: 'Primeras vacunas' }, en: { n: 'Simón', meta: '8 mo · Small', p: 'Curious and mischievous; a puppy eager to learn.', h: 'First vaccines' } },
      { id: 'bella', es: { n: 'Bella', meta: '6 años · Mediana',   p: 'Serena y agradecida; solo pide un rincón tranquilo y compañía.', h: 'Vacunada y esterilizada' }, en: { n: 'Bella', meta: '6 yrs · Medium', p: 'Serene and grateful; she just asks for a quiet corner and company.', h: 'Vaccinated & spayed' } },
      { id: 'toby',  es: { n: 'Toby',  meta: '2 años · Mediano',   p: 'Aventurero y sociable; le encanta explorar y conocer gente nueva.', h: 'Vacunado y esterilizado' }, en: { n: 'Toby',  meta: '2 yrs · Medium', p: 'Adventurous and sociable; loves to explore and meet new people.', h: 'Vaccinated & neutered' } },
      { id: 'coco',  es: { n: 'Coco',  meta: '1 año · Pequeño',    p: 'Mimoso de corazón; busca un regazo donde quedarse dormido.', h: 'Vacunado' }, en: { n: 'Coco',  meta: '1 yr · Small', p: 'A cuddler at heart; looking for a lap to fall asleep on.', h: 'Vaccinated' } },
      { id: 'duque', es: { n: 'Duque', meta: '7 años · Grande',    p: 'Sabio y calmado; sueña con un retiro feliz junto a alguien paciente.', h: 'Vacunado y esterilizado' }, en: { n: 'Duque', meta: '7 yrs · Large', p: 'Wise and calm; dreams of a happy retirement beside someone patient.', h: 'Vaccinated & neutered' } }
    ];
  }

  renderVals() {
    const lang = this.state.lang;
    const t = this.data()[lang];
    const page = this.state.page;

    const navDefs = [
      { key: 'inicio', label: t.nav.home },
      { key: 'nosotros', label: t.nav.about },
      { key: 'adopciones', label: t.nav.adopt },
      { key: 'contacto', label: t.nav.contact }
    ];
    const navItems = navDefs.map(d => {
      const active = d.key === page;
      return {
        label: d.label,
        onClick: this.go(d.key),
        style: 'background:none;border:0;padding:0;cursor:pointer;font-family:var(--font-heading);font-weight:700;font-size:15px;letter-spacing:-0.01em;color:' + (active ? 'var(--color-accent)' : 'var(--color-text)') + ';border-bottom:2px solid ' + (active ? 'var(--color-accent)' : 'transparent') + ';padding-bottom:2px;',
        mobileStyle: 'text-align:left;background:none;border:0;border-top:1px solid var(--color-divider);padding:16px clamp(18px,5vw,56px);cursor:pointer;font-family:var(--font-heading);font-weight:700;font-size:16px;color:' + (active ? 'var(--color-accent)' : 'var(--color-text)') + ';'
      };
    });

    const totalSlides = 5;
    const slides = [{
      id: 'hero-photo-welcome', isWelcome: true, isImg1: true, isImg2: false, isImg3: false, isImg4: false,
      wrapStyle: 'position:absolute;inset:0;opacity:' + (0 === this.state.slide ? '1' : '0') + ';transition:opacity 1.3s ease;'
    }, {
      id: 'hero-photo-extra', isWelcome: true, isImg1: false, isImg2: true, isImg3: false, isImg4: false,
      wrapStyle: 'position:absolute;inset:0;opacity:' + (1 === this.state.slide ? '1' : '0') + ';transition:opacity 1.3s ease;'
    }, {
      id: 'hero-photo-extra2', isWelcome: true, isImg1: false, isImg2: false, isImg3: true, isImg4: false,
      wrapStyle: 'position:absolute;inset:0;opacity:' + (2 === this.state.slide ? '1' : '0') + ';transition:opacity 1.3s ease;'
    }, {
      id: 'hero-photo-extra3', isWelcome: true, isImg1: false, isImg2: false, isImg3: false, isImg4: true, isImg5: false,
      wrapStyle: 'position:absolute;inset:0;opacity:' + (3 === this.state.slide ? '1' : '0') + ';transition:opacity 1.3s ease;'
    }, {
      id: 'hero-photo-extra4', isWelcome: true, isImg1: false, isImg2: false, isImg3: false, isImg4: false, isImg5: true,
      wrapStyle: 'position:absolute;inset:0;opacity:' + (4 === this.state.slide ? '1' : '0') + ';transition:opacity 1.3s ease;'
    }];
    const dots = Array.from({ length: totalSlides }, (_, i) => ({
      onClick: () => this.setState({ slide: i }),
      style: 'width:' + (i === this.state.slide ? '30px' : '12px') + ';height:6px;border:0;padding:0;cursor:pointer;background:' + (i === this.state.slide ? 'var(--color-accent)' : 'rgba(255,255,255,.5)') + ';transition:width .3s ease,background .3s ease;'
    }));
    const activeCaption = this.state.slide === 4 ? t.hero.captions[0] : '';
    const showWelcomeBubble = this.state.slide === 0;

    const dogs = this.dogsData().map(d => {
      const loc = d[lang];
      return {
        slotId: 'dog-' + d.id,
        placeholder: loc.n,
        name: loc.n,
        meta: loc.meta,
        personality: loc.p,
        health: loc.h,
        link: this.wa(t.adopt.waMsg(loc.n))
      };
    });
    const featuredDogs = dogs.slice(0, 3);

    const sponsorTiers = [
      { amount: '$20.000', label: lang === 'es' ? 'Comida para un perrito' : 'Food for one dog', href: this.wa(t.donate.sponsor.waMsg('$20.000')) },
      { amount: '$50.000', label: lang === 'es' ? 'Comida + cuidados' : 'Food + care', href: this.wa(t.donate.sponsor.waMsg('$50.000')) },
      { amount: '$100.000', label: lang === 'es' ? 'Apadrinamiento completo' : 'Full sponsorship', href: this.wa(t.donate.sponsor.waMsg('$100.000')) }
    ];

    const posterBlock = 'display:none;';

    return {
      t, lang, year: new Date().getFullYear(),
      isMobile: this.state.isMobile, isDesktop: !this.state.isMobile,
      menuOpen: this.state.menuOpen, menuClosed: !this.state.menuOpen,
      showMobileMenu: this.state.isMobile && this.state.menuOpen,
      isHome: page === 'inicio', isAbout: page === 'nosotros', isAdopt: page === 'adopciones', isContact: page === 'contacto', isDonate: page === 'donar',
      navItems, slides, dots, activeCaption, showWelcomeBubble, welcomeBubble: t.hero.welcomeBubble, dogs, featuredDogs, sponsorTiers,
      posterBlock,
      donateHref: '#', // overridden by button handlers below via goDonate on the link? keep hash
      goHome: this.go('inicio'), goAbout: this.go('nosotros'), goAdopt: this.go('adopciones'), goContact: this.go('contacto'), goDonate: this.go('donar'),
      toggleMenu: () => this.setState(s => ({ menuOpen: !s.menuOpen })),
      toggleLang: () => this.setState(s => ({ lang: s.lang === 'es' ? 'en' : 'es', menuOpen: false })),
      waContactHref: this.wa(''),
      waKindHref: this.wa(t.donate.kind.body),
      formName: this.state.formName, formMsg: this.state.formMsg,
      onName: (e) => this.setState({ formName: e.target.value }),
      onMsg: (e) => this.setState({ formMsg: e.target.value }),
      contactSubmitHref: this.wa(t.contact.waMsg(this.state.formName, this.state.formMsg))
    };
  }
}
</script>
</body>
</html>
